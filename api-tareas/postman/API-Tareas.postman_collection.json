{
  "info": {
    "name": "API Tareas Académicas",
    "description": "Colección para probar las operaciones CRUD de la API de tareas académicas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tareaId", "value": "CREA_PRIMERO" }
  ],
  "item": [
    {
      "name": "Obtener todas las tareas",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/tareas" }
    },
    {
      "name": "Obtener tarea por ID",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/tareas/{{tareaId}}" }
    },
    {
      "name": "Crear tarea",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('La tarea se creó (201)', function () { pm.response.to.have.status(201); });",
            "const respuesta = pm.response.json();",
            "if (respuesta.tarea && respuesta.tarea._id) pm.collectionVariables.set('tareaId', respuesta.tarea._id);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Proyecto Node.js\",\n  \"curso\": \"Desarrollo Web\",\n  \"descripcion\": \"Crear una API REST utilizando Express\",\n  \"fechaEntrega\": \"2026-09-25\",\n  \"prioridad\": \"ALTA\",\n  \"estado\": \"PENDIENTE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tareas"
      }
    },
    {
      "name": "Actualizar tarea",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Proyecto Node.js actualizado\",\n  \"curso\": \"Desarrollo Web\",\n  \"descripcion\": \"API REST terminada\",\n  \"fechaEntrega\": \"2026-09-25\",\n  \"prioridad\": \"MEDIA\",\n  \"estado\": \"EN_PROCESO\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
      }
    },
    {
      "name": "Eliminar tarea",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/tareas/{{tareaId}}" }
    }
  ]
}
